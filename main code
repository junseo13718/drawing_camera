from pickletools import read_stringnl_noescape_pair


import cv2
import mediapipe as mp
import numpy as np
import time


from pathlib import Path
from datetime import datetime


from mediapipe.tasks.python.metadata.metadata_writers import model_asset_bundle_utils




def main():
   options = mp.tasks.vision.HandLandmarkerOptions(
       base_options=mp.tasks.BaseOptions(
           model_asset_path="hand_landmarker.task"
       ),
       running_mode=mp.tasks.vision.RunningMode.VIDEO,
       num_hands=1
   )


   cap = cv2.VideoCapture(0)


   if not cap.isOpened():
       print("카메라가 켜져 있습니다.")
       return


   last_timestamp = -1


   ret, first_frame = cap.read()
   if not ret:
       print("첫 번째 프레임을 읽지 못했습니다")
       cap.release()
       return


   height, width = first_frame.shape[:2]


   canvas = np.zeros((height, width, 3), dtype=np.uint8)


   prev_x = None
   prev_y = None


   with mp.tasks.vision.HandLandmarker.create_from_options(options) as landmarker:


       while True:
           ret, frame = cap.read()


           if not ret:
               break


           frame = cv2.flip(frame, 1)


           rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)


           mp_image = mp.Image(image_format=mp.ImageFormat.SRGB,
                               data=np.ascontiguousarray(rgb_frame))


           timestamp_ms = time.monotonic_ns()
           timestamp_ms = max(timestamp_ms, last_timestamp + 1)
           last_timestamp = timestamp_ms


           result = landmarker.detect_for_video(
               mp_image, timestamp_ms
           )


           mode = "NO HAND"


           if result.hand_landmarks:
               landmarks = result.hand_landmarks[0]


               index_tip = landmarks[8]


               height, width = frame.shape[:2]


               x = int(index_tip.x * width)
               y = int(index_tip.y * height)


               x = max(0, min(x, width - 1))
               y = max(0, min(y, height - 1))


               index_up = landmarks[8].y < landmarks[6].y
               middle_up = landmarks[12].y < landmarks[10].y
               ring_up = landmarks[16].y < landmarks[14].y
               pinky_up = landmarks[20].y < landmarks[18].y


               drawing_mode = (index_up and not middle_up and not ring_up and not pinky_up)


               if drawing_mode:
                   mode = "DRAW"
                   if prev_x is not None and prev_y is not None:
                       cv2.line(canvas, (prev_x, prev_y), (x, y),
                                (255, 0, 0), 10)


                   else:
                       cv2.circle(canvas, (x, y), 3, (255, 0, 255), -1)


                   prev_x = x
                   prev_y = y
               else:
                   mode = "MOVE"
                   prev_x = None
                   prev_y = None


               cv2.circle(frame, (x, y), 10, (0, 255, 255), -1)




           mask = np.any(canvas != 0, axis=2)
           frame[mask] = canvas[mask]


           cv2.imshow('air_drawing', frame)

           key = cv2.waitKey(1) & 0xFF
           if key == ord("r"):
               canvas[:] = 0
               prev_x = None
               prev_y = None



           elif cv2.waitKey(1) & 0xFF == ord('q'):
               break



   cap.release()
   cv2.destroyAllWindows()


main()


